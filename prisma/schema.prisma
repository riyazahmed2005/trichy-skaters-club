// Prisma schema for PostgreSQL (Neon DB)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          String         @default("USER") // USER, ADMIN
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  posts         Post[]
  achievements  Achievement[]
  galleryImages GalleryImage[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  category  String   // Training, Competition, Event, Club News, Other
  images    String   // JSON stringified array of image URLs
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model Achievement {
  id              String   @id @default(uuid())
  skaterName      String
  competitionName String
  position        String   // GOLD, SILVER, BRONZE, PARTICIPATION
  category        String
  eventDate       DateTime
  description     String
  certificateUrl  String?
  photoUrl        String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedById   String
  submittedBy     User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model GalleryImage {
  id           String   @id @default(uuid())
  url          String
  caption      String
  category     String   // Training, Competition, Events, Winners, Celebrations, Other
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model Event {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  date        DateTime
  time        String
  location    String
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isPin     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
